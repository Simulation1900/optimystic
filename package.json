{
  "name": "optimystic",
  "private": true,
  "description": "Bill Planner: a self-hosted household bill, loan and card-budget planner.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "dev:api": "pnpm --filter @optimystic/api dev",
    "dev:web": "pnpm --filter @optimystic/web dev"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "pg": "8.16.3",
    "@types/pg": "8.15.6"
  }
}
