# Copy to .env next to compose.yml, fill in, then: sudo chmod 600 .env
# Generate each secret with: openssl rand -hex 32
DB_PASSWORD=
SESSION_SECRET=
# Encrypts the saved SimpleFIN connection (card sync). Changing it means reconnecting card sync.
SYNC_KEY=
# The one HTTPS address the app is opened at (tailscale serve)
PUBLIC_URL=https://zimaos.tail057064.ts.net:8443
